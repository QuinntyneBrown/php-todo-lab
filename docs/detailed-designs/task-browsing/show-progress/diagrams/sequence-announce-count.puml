@startuml
title UML sequence behaviour — Announce a count change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as user
box "Frontend — Angular SPA (UI components)" #E0F2FE
  participant "TodoPageComponent" as page
  participant "Polite live region (app shell)" as live
end box
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "TodoStore" as store
  participant "Announcer" as ann
end box
user -> page : Complete a task
page -> store : toggle(id, true)
store -> store : Recompute activeCount and completedCount optimistically (L2-007)
store --> page : New activeCount
page -> page : Build action text and count label from UI_STRINGS
alt Tasks remain active
  page -> ann : announce("Task completed. 2 left")
else All tasks are completed
  page -> ann : announce("Task completed. All done")
end
ann -> live : message signal changes
live --> user : Assistive technology announces the change politely (L2-007)
note over page, ann : The initial list load announces nothing; only user actions announce.
@enduml
