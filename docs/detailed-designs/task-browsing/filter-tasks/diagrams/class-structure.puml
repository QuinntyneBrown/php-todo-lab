@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Filter tasks

package "Angular SPA" {
  class TodoPageComponent <<smart>> {
    +filter: input<string | undefined>
    +ngOnChanges(): void
    +select(filter: TodoFilter): void
  }
  class TodoFilterComponent <<presentational>> {
    +selected: input<TodoFilter>
    +allCount: input<number>
    +activeCount: input<number>
    +doneCount: input<number>
    +selectedChange: output<TodoFilter>
  }
  class TodoStore <<providedIn root>> {
    +todos: Signal<TodoView[]>
    +filter: WritableSignal<TodoFilter>
    -leavingIds: WritableSignal<Set<string>>
    +visibleTodos: Signal<TodoView[]>
  }
  enum TodoFilter {
    all
    active
    done
  }
  class Router <<Angular>> {
    +navigate(commands, extras): Promise<boolean>
  }
}

package "Laravel API" {
  class TodoController {
    +index(request: ListTodosRequest, action: ListTodos): TodoCollection
  }
  class ListTodosRequest {
    +rules(): array
  }
  enum TodoStatus {
    All = all
    Active = active
    Completed = completed
  }
  class ListTodos {
    +handle(status: TodoStatus): TodoList
  }
  interface TodoRepository {
    +list(status: TodoStatus): Collection<int, Todo>
  }
  class EloquentTodoRepository {
    +list(status: TodoStatus): Collection<int, Todo>
  }
  class Todo <<Eloquent>> {
    +active(): Builder
    +completed(): Builder
  }
}

TodoPageComponent --> TodoStore : sets filter in ngOnChanges
TodoStore ..> TodoFilter : holds
TodoPageComponent ..> TodoFilterComponent : binds
TodoPageComponent ..> Router : navigates

TodoController ..> ListTodosRequest : validates with
TodoController --> ListTodos : calls
ListTodosRequest ..> TodoStatus : accepts
ListTodos ..> TodoStatus : receives
ListTodos --> TodoRepository : depends on
EloquentTodoRepository ..|> TodoRepository
EloquentTodoRepository --> Todo : applies scopes

note bottom of TodoStore
  Filter values in the URL are active and done, omitted for All.
  An unknown filter value parses to all.
  The SPA never sends status; the API accepts all, active, and completed.
end note
@enduml
