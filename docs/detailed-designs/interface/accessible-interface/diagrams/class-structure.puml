@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Accessible interface

class TodoPageComponent <<smart component>> {
  +focusRequest: WritableSignal<FocusRequest or null>
  +onDeleted(id: string, event: { viaKeyboard: boolean }): void
  +onTitleSaved(id: string, title: string): void
  +onEditCancelled(): void
  +onToastFocusWithin(focused: boolean): void
}

class FocusRequest {
  +id: string
  +target: 'checkbox' or 'title'
  +seq: number
}

class Announcer <<providedIn root>> {
  +message: Signal<string>
  +announce(message: string): void
}

class AppComponent <<app shell>> {
  renders the aria-live polite element
  bound to Announcer.message
}

class TodoStore <<providedIn root>> {
  +todos: WritableSignal<TodoView[]>
  +editingId: WritableSignal<string or null>
  +toast: WritableSignal<ToastState or null>
  +visibleTodos: Signal<TodoView[]>
  +activeCount: Signal<number>
  +completedCount: Signal<number>
}

class ToastState {
  +message: string
  +tone: 'status' or 'error'
  +undo: { ids: string[] } or null
}

class TodoItemComponent <<presentational>> {
  +todo: InputSignal<TodoView>
  +editing: InputSignal<boolean>
  +focusRequest: InputSignal<FocusRequest or null>
  +toggled: OutputEmitterRef<boolean>
  +editStarted: OutputEmitterRef<void>
  +titleSaved: OutputEmitterRef<string>
  +editCancelled: OutputEmitterRef<void>
  +deleted: OutputEmitterRef<{ viaKeyboard: boolean }>
}

class TodoComposerComponent <<presentational>> {
  +focusRequest: InputSignal<{ target: 'composer', seq } or null>
  +submitted: OutputEmitterRef<string>
}

class TodoFilterComponent <<presentational>> {
  +selected: InputSignal<TodoFilter>
  +allCount: InputSignal<number>
  +activeCount: InputSignal<number>
  +doneCount: InputSignal<number>
}

class TodoHeaderComponent <<presentational>> {
  +date: InputSignal<Date>
}

class TodoListComponent <<presentational>> {
  +todos: InputSignal<TodoView[]>
  +focusRequest: InputSignal<FocusRequest or null>
}

class ToastComponent <<presentational>> {
  +toast: InputSignal<ToastState>
  +undone: OutputEmitterRef<void>
  +focusWithinChange: OutputEmitterRef<boolean>
}

class UI_STRINGS <<constants>> {
  +announcements
  +ariaLabels
  +toasts
}

class "tokens.scss" as Tokens <<design tokens>> {
  focus ring 2 px, offset 2 px
  colour pairs at 4.5 to 1 or 3 to 1
}

TodoPageComponent --> TodoStore : calls actions
TodoPageComponent --> Announcer : announces through
AppComponent ..> Announcer : renders message
TodoPageComponent --> FocusRequest : sets
TodoPageComponent ..> UI_STRINGS : reads text
TodoPageComponent *-- TodoHeaderComponent
TodoPageComponent *-- TodoComposerComponent
TodoPageComponent *-- TodoFilterComponent
TodoPageComponent *-- TodoListComponent
TodoPageComponent *-- ToastComponent
TodoListComponent "1" o-- "*" TodoItemComponent
TodoStore --> ToastState : holds
ToastComponent ..> ToastState : renders
TodoItemComponent ..> UI_STRINGS : aria-label text
TodoItemComponent ..> Tokens : focus ring
@enduml
