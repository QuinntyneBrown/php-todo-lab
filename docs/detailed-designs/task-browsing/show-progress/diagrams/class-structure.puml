@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show progress

class TodoStore <<providedIn root>> {
  +todos: Signal<TodoView[]>
  +activeCount: Signal<number>
  +completedCount: Signal<number>
  +totalCount: Signal<number>
  +progress: Signal<number>
}

class TodoView <<type>> {
  Todo & { pending?: true; tempId?: string }
}

class TodoPageComponent <<smart>> {
  +store: TodoStore
}

class TodoHeaderComponent <<presentational>> {
  +date: input<Date>
  +activeCount: input<number>
  +completedCount: input<number>
}

class TodoFilterComponent <<presentational>> {
  +allCount: input<number>
  +activeCount: input<number>
  +doneCount: input<number>
}

class Announcer <<providedIn root>> {
  +message: Signal<string>
  +announce(message: string): void
}

class AppComponent <<app shell>> {
  polite live region bound to Announcer.message
}

class UI_STRINGS <<const>>

TodoStore "1" o-- "*" TodoView : holds
TodoPageComponent --> TodoStore : reads counts
TodoPageComponent ..> TodoHeaderComponent : binds
TodoPageComponent ..> TodoFilterComponent : binds
TodoPageComponent --> Announcer : announces through
AppComponent --> Announcer : renders message
TodoHeaderComponent ..> UI_STRINGS : reads

note bottom of TodoStore
  activeCount and completedCount are computed from todos.
  progress is completed divided by total, 0 when no tasks exist.
  A pending task counts as active.
end note
@enduml
