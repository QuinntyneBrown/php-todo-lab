@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Toggle task completion

package "Angular SPA" {
  class TodoItemComponent {
    +todo: InputSignal<TodoView>
    +toggled: OutputEmitterRef<boolean>
  }
  class TodoPageComponent {
    -store: TodoStore
    +onToggled(id: string, completed: boolean): void
  }
  class TodoStore {
    +todos: WritableSignal<TodoView[]>
    +toast: WritableSignal<ToastState | null>
    +activeCount: Signal<number>
    +completedCount: Signal<number>
    +toggle(id: string, completed: boolean): Promise<void>
  }
  abstract class TodoApi {
    +update(id: string, changes: UpdateTodoPayload): Promise<Todo>
  }
  class HttpTodoApi
  class InMemoryTodoApi
  class "Todo (core/api/models)" as Todo {
    +id: string
    +title: string
    +completed: boolean
    +completedAt: string | null
    +createdAt: string
    +updatedAt: string
  }
  class TodoView <<type>> {
    Todo & { pending?: true }
  }
  class UpdateTodoPayload {
    +title?: string
    +completed?: boolean
  }
}

package "Laravel API" {
  class TodoController {
    +update(request: UpdateTodoRequest, id: string): TodoResource
  }
  class UpdateTodoRequest {
    +rules(): array
  }
  class UpdateTodo {
    +handle(id: string, changes: array): Todo
  }
  interface TodoRepository {
    +find(id: string): ?Todo
    +update(todo: Todo, changes: array): Todo
  }
  class EloquentTodoRepository
  class InMemoryTodoRepository
  class "Todo (Eloquent)" as TodoModel {
    +id: string
    +title: string
    +completed_at: CarbonImmutable | null
    +completed: bool
  }
  class TodoNotFound <<exception>>
  class TodoResource {
    +toArray(): array
  }
}

TodoItemComponent ..> TodoView : reads
TodoPageComponent --> TodoStore : calls
TodoPageComponent ..> TodoItemComponent : handles toggled
TodoStore --> TodoApi : depends on
TodoStore "1" o-- "*" TodoView : todos
TodoView ..> Todo : extends
TodoApi <|-- HttpTodoApi
TodoApi <|-- InMemoryTodoApi
TodoApi ..> UpdateTodoPayload : accepts
HttpTodoApi ..> TodoController : PATCH /api/v1/todos/{id}

TodoController ..> UpdateTodoRequest : validates with
TodoController --> UpdateTodo : calls handle
TodoController ..> TodoResource : returns
UpdateTodo --> TodoRepository : depends on
TodoRepository <|.. EloquentTodoRepository
TodoRepository <|.. InMemoryTodoRepository
EloquentTodoRepository ..> TodoModel : persists
TodoResource ..> TodoModel : serialises
UpdateTodo ..> TodoNotFound : throws when missing
@enduml
