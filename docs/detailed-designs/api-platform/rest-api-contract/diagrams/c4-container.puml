@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — REST API contract

Person(user, "User", "Single local user of the to-do app")
System_Boundary(app, "php-todo-lab") {
  Container(spa, "Angular SPA", "Angular", "Single-screen UI served by ng serve on :4200 with an /api proxy")
  Container(api, "Laravel API", "PHP 8.4, Laravel", "Versioned JSON REST API on :8000 under /api/v1")
  ContainerDb(db, "MySQL database", "MySQL 8.4, utf8mb4", "Stores the todos table")
}

Rel(user, spa, "Uses", "HTTP")
Rel(spa, api, "Calls /api/v1 endpoints", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "Eloquent")
@enduml
