@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Backend layering

class TodoController {
  +index()
  +store()
  +update()
  +destroy()
  +restore()
  +destroyCompleted()
  +restoreMany()
  .. each at most 10 lines ..
}

class "Form Requests" as FormRequests {
  ListTodosRequest
  StoreTodoRequest
  UpdateTodoRequest
  RestoreTodosRequest
}

package "Action classes" {
  class ListTodos {
    +handle(status: TodoStatus): array
  }
  class CreateTodo {
    +handle(title: string): Todo
  }
  class UpdateTodo {
    +handle(id: string, changes: array): Todo
  }
  class DeleteTodo {
    +handle(id: string): void
  }
  class RestoreTodo {
    +handle(id: string): Todo
  }
  class ClearCompletedTodos {
    +handle(): list<string>
  }
  class RestoreTodos {
    +handle(ids: list<string>): Collection<int, Todo>
  }
}

enum TodoStatus {
  All
  Active
  Completed
}

interface TodoRepository {
  +list(status: TodoStatus): Collection<int, Todo>
  +counts(): array{active: int, completed: int}
  +createWithinLimit(title: string, limit: int): Todo
  +find(id: string): ?Todo
  +update(todo: Todo, changes: array): Todo
  +delete(todo: Todo): void
  +findDeleted(id: string): ?Todo
  +restore(todo: Todo): Todo
  +deleteCompleted(): list<string>
  +restoreMany(ids: list<string>): Collection<int, Todo>
  +purgeDeletedBefore(cutoff: CarbonImmutable, limit: int): int
}

class EloquentTodoRepository
class InMemoryTodoRepository <<test fake>>

class AppServiceProvider {
  +register(): void
}

class Todo {
  +id: string
  +title: string
  +completed_at: immutable_datetime
  +created_at: CarbonImmutable
  +updated_at: CarbonImmutable
  +deleted_at: CarbonImmutable
  +completed: bool
  +scopeActive(query)
  +scopeCompleted(query)
}

class TodoFactory {
  +definition(): array
}

class TodoResource {
  +toArray(request: Request): array
}

class TodoCollection

TodoController ..> FormRequests : validates with
TodoController ..> ListTodos
TodoController ..> CreateTodo
TodoController ..> UpdateTodo
TodoController ..> DeleteTodo
TodoController ..> RestoreTodo
TodoController ..> ClearCompletedTodos
TodoController ..> RestoreTodos
TodoController ..> TodoResource : returns
TodoController ..> TodoCollection : returns
FormRequests ..> TodoStatus : validates status as
ListTodos ..> TodoStatus
ListTodos --> TodoRepository
CreateTodo --> TodoRepository
UpdateTodo --> TodoRepository
DeleteTodo --> TodoRepository
RestoreTodo --> TodoRepository
ClearCompletedTodos --> TodoRepository
RestoreTodos --> TodoRepository
EloquentTodoRepository ..|> TodoRepository
InMemoryTodoRepository ..|> TodoRepository
EloquentTodoRepository ..> Todo : queries
EloquentTodoRepository ..> TodoStatus : maps to scopes
AppServiceProvider ..> EloquentTodoRepository : binds TodoRepository to
TodoFactory ..> Todo : builds test data for
TodoResource ..> Todo : serialises
TodoCollection o-- "*" TodoResource
@enduml
