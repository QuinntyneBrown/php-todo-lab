@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Single-screen shell

Container_Boundary(spa, "Angular SPA") {
  Component(shell, "AppComponent", "Angular app shell", "Hosts the router outlet and the polite live region")
  Component(routes, "routes", "Angular Router, app.routes.ts", "Route / renders TodoPageComponent. Unknown paths redirect to /")
  Component(page, "TodoPageComponent", "Angular smart component", "Lays out the five regions in order, holds the toolbar markup with Clear completed, and requests composer focus after first render")
  Component(header, "TodoHeaderComponent", "Presentational", "Region 1. Weekday and date in the user locale, progress ring")
  Component(composer, "TodoComposerComponent", "Presentational", "Region 2. Text field and Add task button")
  Component(filter, "TodoFilterComponent", "Presentational", "Region 3, toolbar. Filter tabs beside the Clear completed button")
  Component(list, "TodoListComponent", "Presentational", "Region 4. Task rows and empty state")
  Component(toast, "ToastComponent", "Presentational", "Region 5. Toast area")
  Component(announcer, "Announcer", "Angular service, shared/ui/announcer", "announce(message) and a message signal")
  Component(live, "Polite live region", "aria-live polite element in AppComponent", "Announces actions to assistive technology")
  Component(store, "TodoStore", "Injectable, providedIn root", "Holds the toast signal")
  Component(strings, "UI_STRINGS", "Typed constants in ui-strings.ts", "Every user-facing string")
}

Rel(routes, page, "Activates for /")
Rel(page, header, "Renders")
Rel(page, composer, "Renders")
Rel(page, filter, "Renders")
Rel(page, list, "Renders")
Rel(page, toast, "Renders")
Rel(page, announcer, "Calls announce(message) on")
Rel(shell, live, "Renders")
Rel(live, announcer, "Binds to the message signal of")
Rel(shell, routes, "Renders the outlet for")
Rel(page, store, "Reads signals and calls")
Rel(store, strings, "Reads toast and announcement text from")
Rel(page, strings, "Reads template copy from")
@enduml
