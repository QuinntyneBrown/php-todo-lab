@startuml
title UML sequence behaviour — Hourly purge of old soft-deleted tasks
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Laravel Application and Domain" #ECFDF3
  participant "Laravel scheduler" as scheduler
  participant "PurgeDeletedTodos" as cmd
end box
box "Backend — Laravel Infrastructure" #FFF4E5
  participant "EloquentTodoRepository" as repo
  database "MySQL database" as db
end box
scheduler -> cmd : Run todos:purge-deleted (L2-016 hourly schedule)
cmd -> cmd : Compute cutoff as now minus 24 hours (L2-016)
loop until a chunk deletes fewer than 500 rows
  cmd -> repo : purgeDeletedBefore(cutoff, 500)
  repo -> db : Permanently delete up to 500 rows where deleted_at is before cutoff
  db --> repo : Rows deleted in this chunk
  repo --> cmd : Chunk count
end
cmd -> cmd : Log and print "Purged {n} soft-deleted todos."
cmd --> scheduler : Exit 0
@enduml
