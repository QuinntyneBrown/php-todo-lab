@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Frontend structure

class TodoPageComponent <<smart>> {
  -store: TodoStore
}

class TodoHeaderComponent <<presentational>>
class TodoComposerComponent <<presentational>>
class TodoFilterComponent <<presentational>>
class TodoListComponent <<presentational>>
class TodoItemComponent <<presentational>>
class TodoEmptyStateComponent <<presentational>>
class ToastComponent <<presentational>>

class TodoStore <<providedIn root>> {
  -api: TodoApi
  -listResource: resource(loader: api.list())
  +todos: linkedSignal<TodoView[]>
  +filter: signal
  +editingId: signal
  +toast: signal<ToastState | null>
  +loading: computed
  +loadFailed: computed
  +activeCount: computed
  +completedCount: computed
  +totalCount: computed
  +visibleTodos: computed
  +progress: computed
  +addTask(title)
  +toggle(id, completed)
  +beginEdit(id)
  +saveTitle(id, title)
  +cancelEdit()
  +delete(id)
  +clearCompleted()
  +undo()
  +dismissToast()
  +reload()
}

abstract class TodoApi {
  +list(): Promise<TodoListResponse>
  +create(title: string): Promise<Todo>
  +update(id: string, changes: UpdateTodoPayload): Promise<Todo>
  +delete(id: string): Promise<void>
  +restore(id: string): Promise<Todo>
  +clearCompleted(): Promise<ClearCompletedResponse>
  +restoreMany(ids: readonly string[]): Promise<Todo[]>
}

class HttpTodoApi {
  -http: HttpClient
  calls wrapped with firstValueFrom
  timeout(10_000) on every request
  failures converted to ApiError
}

class InMemoryTodoApi <<test fake>>

class HttpClient <<Angular>>

package "core/api/models" as Models {
  interface Todo
  interface TodoListResponse
  interface TodoListMeta
  interface UpdateTodoPayload
  interface ClearCompletedResponse
  interface ProblemDetails
  class ApiError {
    +kind: FailureKind
    +status?: number
    +problem?: ProblemDetails
  }
}

TodoPageComponent --> TodoStore : injects
TodoPageComponent ..> TodoHeaderComponent : renders
TodoPageComponent ..> TodoComposerComponent : renders
TodoPageComponent ..> TodoFilterComponent : renders
TodoPageComponent ..> TodoListComponent : renders
TodoPageComponent ..> ToastComponent : renders
TodoListComponent ..> TodoItemComponent : renders
TodoListComponent ..> TodoEmptyStateComponent : renders
TodoStore --> TodoApi : depends on
HttpTodoApi ..|> TodoApi
InMemoryTodoApi ..|> TodoApi
HttpTodoApi --> HttpClient : only user
HttpTodoApi ..> Models : uses
InMemoryTodoApi ..> Models : uses
TodoApi ..> Models : uses
@enduml
