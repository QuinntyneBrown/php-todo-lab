@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Delete task

package "Angular SPA" {
  class TodoItemComponent {
    +todo: InputSignal<TodoView>
    +deleted: OutputEmitterRef<{ viaKeyboard: boolean }>
  }
  class TodoListComponent {
    +todos: InputSignal<TodoView[]>
    +deleted: OutputEmitterRef<string>
  }
  class ToastComponent {
    +toast: InputSignal<ToastState | null>
    +undone: OutputEmitterRef<void>
  }
  class TodoPageComponent {
    -store: TodoStore
    +onDeleted(id: string): void
    +onUndo(): void
    +focusRequest: WritableSignal<FocusRequest | null>
  }
  class TodoStore {
    +todos: WritableSignal<TodoView[]>
    +toast: WritableSignal<ToastState | null>
    +delete(id: string): Promise<void>
    +undo(): Promise<void>
    +dismissToast(): void
  }
  class ToastState {
    +message: string
    +tone: 'status' | 'error'
    +undo: { ids: string[] } | null
  }
  abstract class TodoApi {
    +delete(id: string): Promise<void>
    +restore(id: string): Promise<Todo>
  }
  class HttpTodoApi
  class InMemoryTodoApi
  class "Todo (core/api/models)" as Todo
  class TodoView <<type>> {
    Todo & { pending?: true }
  }
}

package "Laravel API" {
  class TodoController {
    +destroy(id: string): Response
    +restore(id: string): TodoResource
  }
  class DeleteTodo {
    +handle(id: string): void
  }
  class RestoreTodo {
    +handle(id: string): Todo
  }
  interface TodoRepository {
    +find(id: string): ?Todo
    +findDeleted(id: string): ?Todo
    +delete(todo: Todo): void
    +restore(todo: Todo): Todo
  }
  class EloquentTodoRepository
  class InMemoryTodoRepository
  class "Todo (Eloquent)" as TodoModel {
    +id: string
    +deleted_at: CarbonImmutable | null
  }
  class TodoResource
  class TodoNotFound <<exception>>
}

TodoItemComponent ..> TodoView : reads
TodoListComponent *-- TodoItemComponent : renders rows
TodoPageComponent --> TodoStore : calls
TodoPageComponent ..> TodoListComponent : handles deleted
TodoPageComponent ..> ToastComponent : handles undone
TodoStore --> TodoApi : depends on
TodoStore "1" o-- "*" TodoView : todos
TodoView ..> Todo : extends
TodoStore "1" o-- "0..1" ToastState : toast
TodoApi <|-- HttpTodoApi
TodoApi <|-- InMemoryTodoApi
HttpTodoApi ..> TodoController : DELETE and POST restore

TodoController --> DeleteTodo : calls handle
TodoController --> RestoreTodo : calls handle
TodoController ..> TodoResource : returns
DeleteTodo --> TodoRepository : depends on
RestoreTodo --> TodoRepository : depends on
TodoRepository <|.. EloquentTodoRepository
TodoRepository <|.. InMemoryTodoRepository
EloquentTodoRepository ..> TodoModel : persists
DeleteTodo ..> TodoNotFound : throws
RestoreTodo ..> TodoNotFound : throws
TodoResource ..> TodoModel : serialises
@enduml
