@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Add a task

package "Angular SPA" {
  class TodoPageComponent <<smart>> {
    +store: TodoStore
    +focusRequest: Signal<FocusRequest | null>
  }
  class TodoComposerComponent <<presentational>> {
    +serverError: InputSignal<string | null>
    +restoreText: InputSignal<string | null>
    +focusRequest: InputSignal<FocusRequest | null>
    +submitted: OutputEmitterRef<string>
  }
  class TodoStore <<providedIn root>> {
    +todos: WritableSignal<TodoView[]>
    +filter: WritableSignal<TodoFilter>
    +toast: WritableSignal<ToastState | null>
    +addTask(title: string): Promise<void>
  }
  abstract class TodoApi {
    +create(title: string): Promise<Todo>
  }
  class HttpTodoApi {
    +create(title: string): Promise<Todo>
  }
  class InMemoryTodoApi <<test fake>> {
    +create(title: string): Promise<Todo>
  }
  class "TodoView" as TodoView <<type>> {
    Todo & { pending?: true; tempId?: string }
    id is tmp-<uuid> while pending
  }
  class ApiError {
    +kind: FailureKind
    +status?: number
    +problem?: ProblemDetails
  }
}

package "Laravel API" {
  class TodoController {
    +store(request: StoreTodoRequest, action: CreateTodo): JsonResponse
  }
  class StoreTodoRequest {
    +rules(): array
  }
  class CreateTodo {
    +handle(title: string): Todo
  }
  interface TodoRepository {
    +createWithinLimit(title: string, limit: int): Todo
  }
  class EloquentTodoRepository {
    +createWithinLimit(title: string, limit: int): Todo
  }
  class InMemoryTodoRepository <<test fake>> {
    +createWithinLimit(title: string, limit: int): Todo
  }
  class Todo <<Eloquent>> {
    +id: string
    +title: string
    +completed_at: ?CarbonImmutable
    +completed: bool
  }
  class TodoResource {
    +toArray(): array
  }
  class TodoLimitReached <<exception>> {
  }
  class ProblemDetailsRenderer <<invokable>> {
    +__invoke(e: Throwable, request: Request): ?JsonResponse
  }
}

TodoPageComponent --> TodoStore : calls
TodoPageComponent ..> TodoComposerComponent : binds
TodoStore --> TodoApi : depends on
TodoStore "1" o-- "*" TodoView : holds
HttpTodoApi ..|> TodoApi
InMemoryTodoApi ..|> TodoApi
HttpTodoApi ..> ApiError : throws
HttpTodoApi ..> TodoController : POST /api/v1/todos

TodoController ..> StoreTodoRequest : validates with
TodoController --> CreateTodo : calls
TodoController ..> TodoResource : returns 201
CreateTodo --> TodoRepository : depends on
EloquentTodoRepository ..|> TodoRepository
InMemoryTodoRepository ..|> TodoRepository
EloquentTodoRepository --> Todo : creates
EloquentTodoRepository ..> TodoLimitReached : throws at 500
ProblemDetailsRenderer ..> TodoLimitReached : renders 422, code todo_limit_reached
TodoResource ..> Todo : serialises
@enduml
