@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Handle connectivity failures

class FailureKind <<type>> {
  network | server | client
}

class ApiError <<error>> {
  +kind: FailureKind
  +status?: number
  +problem?: ProblemDetails
}

abstract class TodoApi {
  +list(): Promise<TodoListResponse>
  +create(title: string): Promise<Todo>
  +update(id: string, changes: UpdateTodoPayload): Promise<Todo>
  +delete(id: string): Promise<void>
  +restore(id: string): Promise<Todo>
  +clearCompleted(): Promise<ClearCompletedResponse>
  +restoreMany(ids: readonly string[]): Promise<Todo[]>
}

class HttpTodoApi {
  -http: HttpClient
  +list(): Promise<TodoListResponse>
  +create(title: string): Promise<Todo>
  +update(id: string, changes: UpdateTodoPayload): Promise<Todo>
  +delete(id: string): Promise<void>
  +restore(id: string): Promise<Todo>
  +clearCompleted(): Promise<ClearCompletedResponse>
  +restoreMany(ids: readonly string[]): Promise<Todo[]>
  -toApiError(error: unknown): ApiError
}

class InMemoryTodoApi <<test fake>> {
  +failOnDemand: boolean
}

class TodoStore <<providedIn root>> {
  +todos: WritableSignal<TodoView[]>
  +toast: WritableSignal<ToastState or null>
  +loadFailed: Signal<boolean>
  +addTask(title: string): Promise<void>
  +toggle(id: string, completed: boolean): Promise<void>
  +saveTitle(id: string, title: string): Promise<void>
  +delete(id: string): Promise<void>
  +clearCompleted(): Promise<void>
  +reload(): void
  rollbacks are internal to each method
}

class Connectivity <<providedIn root>> {
  +online: Signal<boolean>
  seeded from navigator.onLine
  updated by window online and offline events
}

class TodoPageComponent <<smart component>> {
  offline banner markup, role="status":
  "You're offline. Changes will fail until you reconnect."
}

class ToastComponent <<presentational>> {
  +toast: InputSignal<ToastState>
}

TodoApi <|.. HttpTodoApi
TodoApi <|.. InMemoryTodoApi
HttpTodoApi ..> ApiError : throws
note right of HttpTodoApi
  Every request pipes through timeout of 10 000 ms.
  list adds retry: count 2, delays 300 ms then 900 ms,
  for network errors and 5xx only.
  Writes are never retried.
end note
ApiError --> FailureKind
TodoStore --> TodoApi : depends on
TodoPageComponent --> TodoStore : reads
TodoPageComponent --> Connectivity : reads online
TodoPageComponent *-- ToastComponent
@enduml
