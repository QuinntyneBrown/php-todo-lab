@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Keyboard operation

class TodoPageComponent <<smart>> {
  -store: TodoStore
  -composerFocus: WritableSignal<{ target: 'composer', seq } or null>
  +onDocumentKeydown(event: KeyboardEvent): void
  @HostListener('document:keydown')
  skips input, textarea, contenteditable
  toolbar markup with Clear completed button
}

class TodoComposerComponent <<presentational>> {
  +focusRequest: InputSignal<{ target: 'composer', seq } or null>
  +submitted: OutputEmitterRef<string>
  -input: viewChild text field
  effect calls input.focus() per request
}

class TodoFilterComponent <<presentational>> {
  filter tab buttons
}

class TodoListComponent <<presentational>>

class TodoItemComponent <<presentational>> {
  +toggled: OutputEmitterRef<boolean>
  +editStarted: OutputEmitterRef<void>
  +titleSaved: OutputEmitterRef<string>
  +editCancelled: OutputEmitterRef<void>
  +deleted: OutputEmitterRef<{ viaKeyboard: boolean }>
  native checkbox, title button, delete button
}

class TodoStore <<providedIn root>> {
  +todos: WritableSignal<TodoView[]>
  +editingId: WritableSignal<string or null>
  +addTask(title: string): Promise<void>
  +toggle(id: string, completed: boolean): Promise<void>
  +beginEdit(id: string): void
  +saveTitle(id: string, title: string): Promise<void>
  +cancelEdit(): void
  +delete(id: string): Promise<void>
}

TodoPageComponent --> TodoStore : injects
TodoPageComponent ..> TodoComposerComponent : renders, passes focusRequest
TodoPageComponent ..> TodoFilterComponent : renders
TodoPageComponent ..> TodoListComponent : renders
TodoListComponent ..> TodoItemComponent : renders in list order
TodoComposerComponent ..> TodoPageComponent : submitted output
TodoItemComponent ..> TodoListComponent : toggled, editStarted, titleSaved, editCancelled, deleted
@enduml
