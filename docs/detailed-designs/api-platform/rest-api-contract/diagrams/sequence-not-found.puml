@startuml
title UML sequence behaviour — Unknown route or unknown todo returns 404 problem details
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "HttpTodoApi" as client
end box
box "Backend — Laravel API (HTTP layer)" #D1FADF
  participant "routes/api.php" as routes
  participant "TodoController" as ctrl
  participant "ProblemDetailsRenderer" as errors
end box
box "Backend — Laravel Application and Domain" #ECFDF3
  participant "Action class" as action
end box
box "Backend — Laravel Infrastructure" #FFF4E5
  participant "EloquentTodoRepository" as repo
  database "MySQL database" as db
end box
alt Unknown route such as /api/v2/todos
  client -> routes : GET /api/v2/todos
  routes -> routes : No route matches the path (L2-018 criterion 3)
  routes -> errors : Raise not-found exception
else Unknown todo id on a known route
  client -> routes : PATCH /api/v1/todos/{id}
  routes -> routes : {id} passes whereUlid (a malformed id matches no route and ends here as not found)
  routes -> ctrl : Dispatch to the controller
  ctrl -> action : handle() with the id
  action -> repo : Find the non-deleted todo
  repo -> db : Query by id
  db --> repo : No row
  repo --> action : null
  action --> errors : Throw TodoNotFound
end
errors -> errors : Build problem details: type about:blank, title Not Found, status 404, detail "The requested resource was not found." (L2-020 criterion 2)
errors --> client : 404 application/problem+json, never an HTML page
@enduml
