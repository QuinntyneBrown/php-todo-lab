@startuml
title UML sequence behaviour — Return focus to the row title when edit mode ends
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as user
box "Frontend — Angular SPA (UI components)" #E0F2FE
  participant "TodoItemComponent" as item
  participant "TodoPageComponent" as page
end box
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "TodoStore" as store
end box
user -> item : Activate the title (click, or Enter on the focused title)
item -> page : editStarted output
page -> store : beginEdit(id)
store --> page : editingId set
item --> user : Text field with the title selected and focused
alt user presses Enter
  user -> item : Enter
  item -> page : titleSaved output
  page -> store : saveTitle(id, title)
  store --> page : editingId cleared
else user presses Escape
  user -> item : Escape
  item -> page : editCancelled output
  page -> store : cancelEdit()
  store --> page : editingId cleared
end
page -> page : Set focusRequest { id, target: 'title', seq }
page -> item : focusRequest input
item -> item : Replace the text field with the title button
item -> item : effect calls focus() on the title button viewChild
item --> user : Focus returns to the row title button (L2-031)
note over item
  Ending edit mode by blur leaves focus where the user moved it.
  L2-031 requires the return of focus for Enter and Escape only.
end note
@enduml
