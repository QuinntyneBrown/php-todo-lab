@startuml
title UML sequence behaviour — Matching toast and announcement copy
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as user
box "Frontend — Angular SPA (UI components)" #E0F2FE
  participant "TodoItemComponent" as item
  participant "TodoPageComponent" as page
  participant "Polite live region" as live
  participant "ToastComponent" as toast
end box
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "TodoStore" as store
  participant "UI_STRINGS" as strings
  participant "HttpTodoApi" as http
end box
user -> item : Activate the delete control
item -> page : Emit delete through output()
page -> store : Request deletion of the task
store -> http : Call TodoApi to delete the task
alt Server accepts the deletion
  http --> store : Deletion confirmed
  store -> strings : Read toast text Task deleted and action Undo (L2-025)
  strings --> store : Strings from the one typed constants file (L2-025)
  store -> store : Set toast signal
  store -> strings : Read announcement text with the verb deleted (text TO SUPPLY, L2-025)
  strings --> store : Announcement string
  page -> toast : Pass toast signal value
  toast --> user : Toast shows the same verb as the announcement (L2-025)
  page -> live : Pass announcement text
  live --> user : Polite announcement (L2-025)
else Request fails
  http --> store : Rejected promise
  store -> strings : Read error text Couldn't delete that task. (L2-025)
  strings --> store : Error string states the problem
  store -> store : Set toast signal as error
  page -> toast : Pass toast signal value
  toast --> user : Error toast without apology or exclamation mark (L2-025)
end
@enduml
