@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Single-screen shell

class "routes (app.routes.ts)" as Routes {
  path "" renders TodoPageComponent
  path "**" redirects to /
}

class TodoPageComponent <<smart>> {
  -store: TodoStore
  -today: Date = new Date()
  -composerFocus: WritableSignal<{ target: 'composer', seq } or null>
  regions in order: header, composer, toolbar, list, toast area
  toolbar markup: TodoFilterComponent and Clear completed button
  requests composer focus after first render when (hover: hover)
}

class TodoHeaderComponent <<presentational>> {
  +date: InputSignal<Date>
  +activeCount: InputSignal<number>
  +completedCount: InputSignal<number>
  weekday and date formatted in the user locale
}
class TodoComposerComponent <<presentational>> {
  +focusRequest: InputSignal<{ target: 'composer', seq } or null>
  +submitted: OutputEmitterRef<string>
}
class TodoFilterComponent <<presentational>>
class TodoListComponent <<presentational>>
class ToastComponent <<presentational>>

class Announcer <<providedIn root>> {
  +message: Signal<string>
  +announce(message: string): void
}

class AppComponent <<app shell>> {
  router outlet
  aria-live polite element bound to Announcer.message
}

class TodoStore <<providedIn root>> {
  +toast: WritableSignal<ToastState or null>
}

class UI_STRINGS <<typed constants>> {
  all user-facing strings, ui-strings.ts
  +composer
  +filters
  +emptyStates
  +toasts
  +announcements
  +ariaLabels
  +errors
}

Routes --> TodoPageComponent : activates for /
TodoPageComponent ..> TodoHeaderComponent : renders 1st
TodoPageComponent ..> TodoComposerComponent : renders 2nd
TodoPageComponent ..> TodoFilterComponent : renders 3rd
TodoPageComponent ..> TodoListComponent : renders 4th
TodoPageComponent ..> ToastComponent : renders 5th
TodoPageComponent --> Announcer : announces through
AppComponent ..> Announcer : renders message
AppComponent ..> Routes : router outlet
TodoPageComponent --> TodoStore : injects
TodoStore ..> UI_STRINGS : reads
TodoPageComponent ..> UI_STRINGS : reads
@enduml
