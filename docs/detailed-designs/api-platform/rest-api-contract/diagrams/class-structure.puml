@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — REST API contract

class "routes/api.php" as Routes {
  +prefix: "/api/v1"
  +{id}: whereUlid
}

class TodoController {
  +index(request: ListTodosRequest): TodoCollection
  +store(request: StoreTodoRequest): TodoResource
  +update(request: UpdateTodoRequest, id: string): TodoResource
  +destroy(id: string): Response
  +restore(id: string): TodoResource
  +destroyCompleted(): JsonResponse
  +restoreMany(request: RestoreTodosRequest): TodoCollection
}

abstract class FormRequest {
  +rules(): array
}

class ListTodosRequest
class StoreTodoRequest
class UpdateTodoRequest
class RestoreTodosRequest

class TodoResource {
  +toArray(request: Request): array
}

class TodoCollection {
  +toArray(request: Request): array
}

class Todo {
  +id: string
  +title: string
  +completed_at: CarbonImmutable
  +created_at: CarbonImmutable
  +updated_at: CarbonImmutable
  +deleted_at: CarbonImmutable
  +completed: bool
}

class "App\Exceptions\ProblemDetailsRenderer" as ExceptionRendering <<invokable, registered in bootstrap/app.php>> {
  +__invoke(e: Throwable, request: Request): ?JsonResponse
}

class TodoNotFound <<exception>>
class TodoLimitReached <<exception>>

class ProblemDetails <<application/problem+json body>> {
  +type: string
  +title: string
  +status: int
  +detail: string
  +errors: map of field to list of messages
  +code: string
}

Routes --> TodoController : dispatches to
TodoController ..> ListTodosRequest : validates with
TodoController ..> StoreTodoRequest : validates with
TodoController ..> UpdateTodoRequest : validates with
TodoController ..> RestoreTodosRequest : validates with
ListTodosRequest --|> FormRequest
StoreTodoRequest --|> FormRequest
UpdateTodoRequest --|> FormRequest
RestoreTodosRequest --|> FormRequest
TodoController ..> TodoResource : returns
TodoController ..> TodoCollection : returns
TodoCollection o-- "*" TodoResource : wraps
TodoResource ..> Todo : serialises
ExceptionRendering ..> ProblemDetails : builds
ExceptionRendering ..> TodoNotFound : maps to 404
ExceptionRendering ..> TodoLimitReached : maps to 422
@enduml
