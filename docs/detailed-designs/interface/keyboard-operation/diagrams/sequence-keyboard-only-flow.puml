@startuml
title UML sequence behaviour — Keyboard-only add, complete, edit, and delete
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as user
box "Frontend — Angular SPA (UI components)" #E0F2FE
  participant "TodoComposerComponent" as composer
  participant "TodoItemComponent" as item
  participant "TodoPageComponent" as page
end box
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "TodoStore" as store
end box
note over user, item
  Tab order (L2-023): composer, Add task, filter tabs, Clear completed,
  then each row in list order: checkbox, title, delete
end note
== Add ==
user -> composer : Type a title with focus in the composer
user -> composer : Press Enter on valid text
composer -> page : submitted output
page -> store : addTask(title) (L2-001, L2-023)
== Complete ==
user -> item : Press Tab until the row checkbox has focus
user -> item : Press Space on the checkbox
item -> page : toggled output through the list (L2-009, L2-023)
page -> store : toggle(id, completed)
== Edit ==
user -> item : Press Tab to the row title
user -> item : Press Enter to start editing
item -> page : editStarted output
page -> store : beginEdit(id)
item -> item : Replace the title with a text field (L2-012, L2-023)
alt User presses Enter
  user -> item : Press Enter
  item -> page : titleSaved output
  page -> store : saveTitle(id, title)
else User presses Escape
  user -> item : Press Escape
  item -> page : editCancelled output
  page -> store : cancelEdit(), no request (L2-012, L2-023)
end
== Delete ==
user -> item : Press Tab to the row delete control
user -> item : Press Enter or Space on the delete control
item -> page : deleted output { viaKeyboard: true } through the list
page -> store : delete(id) (L2-015, L2-023)
note over user, store
  Every flow completes without a pointer (L2-023)
end note
@enduml
