@startuml
title UML sequence behaviour — Edit task title, save failure and missing task
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "User" as user
box "Frontend — Angular SPA (UI components)" #E0F2FE
  participant "TodoItemComponent" as item
  participant "ToastComponent" as toast
end box
box "Frontend — Angular SPA (state and API client)" #E0F2FE
  participant "TodoStore" as store
  participant "HttpTodoApi" as api
end box
box "Backend — Laravel API (HTTP layer)" #D1FADF
  participant "TodoController" as ctrl
end box
box "Backend — Laravel Application and Domain" #ECFDF3
  participant "UpdateTodo" as action
end box
box "Backend — Laravel Infrastructure" #FFF4E5
  participant "EloquentTodoRepository" as repo
end box
user -> item : Save a changed title (L2-012)
item -> store : saveTitle(id, title) through TodoPageComponent
store -> store : Remember previous title, apply optimistic title (L2-012)
store -> api : updateTodo(id, title)
api -> ctrl : PATCH /api/v1/todos/{id} with title
alt Network error or 5xx response
  ctrl --> api : 5xx or no response
  api --> store : Rejected request
  store -> store : Restore the previous title (L2-013)
  store --> item : Previous title shown
  store -> toast : Set toast to "Couldn't save that change." (L2-013)
  toast --> user : Error toast shown
else Task deleted elsewhere, unknown id, or malformed id
  ctrl -> action : Invoke with id
  action -> repo : Find non-deleted todo by id
  repo --> action : Not found
  action --> ctrl : Not-found condition
  ctrl --> api : 404 problem details (L2-014)
  api --> store : Rejected request with status 404
  store -> store : Remove the row from the todos signal (L2-014)
  store -> toast : Set toast to "That task no longer exists." (L2-014)
  toast --> user : Toast shown, row gone from the list
end
@enduml
