@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — List tasks

Container_Boundary(spa, "Angular SPA") {
  Component(page, "TodoPageComponent", "Smart component", "Chooses the loading, empty, error, or loaded view and hosts the error banner")
  Component(list, "TodoListComponent", "Presentational component", "Renders 3 skeleton rows or the task rows")
  Component(item, "TodoItemComponent", "Presentational component", "Renders one task row")
  Component(empty, "TodoEmptyStateComponent", "Presentational component", "Renders the empty-state heading and text")
  Component(store, "TodoStore", "Signal store", "Reads the list with resource and TodoApi.list(), exposes todos, loading, and loadFailed")
  Component(http, "HttpTodoApi", "TodoApi adapter", "Only class that uses HttpClient; times out after 10 s and retries the list read twice")
  Component(strings, "UI_STRINGS", "ui-strings.ts", "Typed constants for all user-facing copy")
}

Container_Boundary(api, "Laravel API") {
  Component(routes, "routes/api.php", "Route file", "Maps GET /api/v1/todos to TodoController")
  Component(ctrl, "TodoController", "Thin controller", "Validates, calls ListTodos, returns the list response")
  Component(req, "ListTodosRequest", "Form Request", "Validates the optional status parameter")
  Component(action, "ListTodos", "Action", "Returns todos and counts for a TodoStatus")
  Component(repo, "TodoRepository", "Interface", "Persistence port")
  Component(eloquent, "EloquentTodoRepository", "Repository", "Orders and counts non-deleted todos")
  Component(model, "Todo", "Eloquent model", "SoftDeletes hides deleted rows")
  Component(res, "TodoCollection", "API Resource collection", "Wraps data and meta.active and meta.completed")
}

ContainerDb(db, "MySQL database", "MySQL 8.4", "todos table")

Rel(page, store, "Reads todos, loading state, and error from")
Rel(page, list, "Binds todos and loading flag")
Rel(page, empty, "Binds empty-state kind")
Rel(list, item, "Renders rows with")
Rel(page, strings, "Reads copy from")
Rel(store, http, "Calls list() through the TodoApi port")
Rel(http, routes, "GET /api/v1/todos", "JSON/HTTP")
Rel(routes, ctrl, "Routes to")
Rel(ctrl, req, "Validates with")
Rel(ctrl, action, "Calls")
Rel(ctrl, res, "Returns 200 with")
Rel(action, repo, "Depends on")
Rel(eloquent, repo, "Implements")
Rel(eloquent, model, "Queries")
Rel(eloquent, db, "Selects ordered rows and counts", "SQL")
@enduml
